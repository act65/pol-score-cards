[Unit]
# Nightly v3.0 work for pol-score-cards. The scheduler sleeps until 23:00,
# works the rotation until 06:00, then sleeps again. It spends NO subscription
# quota outside that window.
#
# The rotation is NIGHTLY_PLAN in tonight.py, not a flag here. As of 2026-09-25
# that is `resolve_divination` — window extraction is finished (5,548/5,548) and
# the remaining work is searching for evidence on the 1,771 divination claims
# still published from the model's unaided guess. ~591 calls at 3 items each.
# It exits 0 of its own accord when the queue is empty.
#
# This unit exists because the machine crashed twice (2026-09-04, 2026-09-08)
# and the run only came back when someone noticed. Two nights were lost the
# first time.
#
# Remove with:
#   systemctl --user disable --now nz-scorecards-nightly
#   rm ~/.config/systemd/user/nz-scorecards-nightly.service
Description=NZ scorecards nightly run (23:00-06:00) — resolving divination claims
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/act65/Documents/repos/pol-score-cards/attribute-extraction
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/act65/.local/bin:/home/act65/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/act65/miniconda3/bin/python tonight.py nightly --at 23:00 --until 06:00
# on-failure, not always: the scheduler exits 0 when every stage is finished,
# and that must be allowed to stay finished.
Restart=on-failure
RestartSec=60
StandardOutput=append:/home/act65/Documents/repos/pol-score-cards/attribute-extraction/nightly.log
StandardError=append:/home/act65/Documents/repos/pol-score-cards/attribute-extraction/nightly.log

[Install]
WantedBy=default.target
