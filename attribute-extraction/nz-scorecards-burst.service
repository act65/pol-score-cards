[Unit]
# A one-off continuous run. Deliberately spends quota during the day, which the
# nightly unit exists to avoid — hence a separate, non-enabled unit.
# Re-pointed 2026-09-25 to FINISH the term: 248 windows left of 5,548, roughly
# 23h of work at the observed ~11 windows/hour. The deadline is generous on
# purpose — the run exits as soon as the stage reports done, so an early finish
# costs nothing and a slow one is not cut off mid-term.
#
# Conflicts= stops the nightly scheduler while this runs; ExecStopPost= starts
# it again when this finishes, so the normal 23:00-06:00 schedule resumes on
# its own with nobody needing to remember.
Description=NZ scorecards burst run — finish the 54th term (until 2026-09-26 09:00)
Conflicts=nz-scorecards-nightly.service
After=nz-scorecards-nightly.service

[Service]
Type=simple
WorkingDirectory=/home/act65/Documents/repos/pol-score-cards/attribute-extraction
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/act65/.local/bin:/home/act65/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/act65/miniconda3/bin/python tonight.py burst --until "2026-09-26 09:00" --stages windows
Restart=on-failure
RestartSec=30
# --no-block is REQUIRED, not tidiness. Without it this deadlocked on
# 2026-09-19: `systemctl start` waits for its job, but the job is queued
# behind this unit's own deactivation (Conflicts=), so stop-post timed
# out after 90s, was killed, and the nightly schedule never came back.
ExecStopPost=/bin/systemctl --user --no-block start nz-scorecards-nightly.service
StandardOutput=append:/home/act65/Documents/repos/pol-score-cards/attribute-extraction/nightly.log
StandardError=append:/home/act65/Documents/repos/pol-score-cards/attribute-extraction/nightly.log
