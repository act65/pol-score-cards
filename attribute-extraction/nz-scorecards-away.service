[Unit]
# Unattended multi-day run, 2026-10-02. The user is away for several days and
# cannot resume anything, so this is built to need nobody: it survives reboot,
# restarts itself after a fault, and ends on its own when the work is done.
#
# WORK, in one rotating plan (tonight.NIGHTLY_PLAN):
#   resolve_veracity    3,895 claims of a STRATIFIED 3,924 (30 per politician,
#                       even stride through the term -- resolve.stratify). 1,299
#                       calls, ~67h at the measured 58 verdicts/h. The whole
#                       25,747-claim pool would be 444h, and working it
#                       front-to-back is what pulled this stage on 2026-09-08
#                       (371 of 389 verdicts from one month out of seven).
#                       MEASURED 2026-10-05/06: $3.72/call and ~41
#                       verdicts/h, not the $2.19 and 58/h divination
#                       gave -- veracity claims need more searching. So
#                       the full cap-30 sample is ~86h and ~$4,400, well
#                       over the 67h/$1,600 first projected.
# DONE on 2026-10-04 12:58, unattended, in 39.6h for $2,264: divination 100%
# resolved (1,884 verdicts, 72.1% accuracy) and acuity 5,548/5,548 (11,485
# examples), passing all four gates -- shrink 0.94, true between-MP sd 13.9
# against sampling noise 3.4. The deadline below is a backstop, not the plan;
# the stage exits EX_DONE as soon as its queue is empty.
#
# WHY THIS IS NOT THE BURST UNIT. nz-scorecards-burst.service has no [Install]
# section, so it is `static`: it cannot be enabled, and nothing starts it after
# a reboot. That is exactly how the last run died — it worked 11h from 19:26 on
# 2026-09-27, the machine was shut down at 06:33:37 the next morning (gnome
# endSessionDialog in the journal), and nothing ran for the following four days
# because no unit was armed to come back. This one is WantedBy=default.target
# and enabled.
#
# PROVEN, not just designed: the machine crashed at 19:32 on 2026-10-02,
# 82 minutes into the run. It booted again at 21:22:11 and systemd started
# this unit at 21:22:13 with no one present. Both stages resumed from their
# own files -- divination from 1,535 verdicts, acuity from 147 windows --
# so the only loss was the machine's downtime and the two in-flight calls.
#
# WHY THERE IS NO WATCHER. The supervisor is systemd. A shell watcher polling
# `pgrep -f "extract_hansard.py ..."` matches ITS OWN command line, so it never
# sees the job end and never exits — that bug has cost this project a run
# before. systemd also owns the cgroup, so a restart or stop kills the child
# `claude -p` workers with the parent; killing the old nohup'd runner by hand
# left four of them reparented to pid 1, still spending quota.
#
# Restore the normal schedule when back:
#   systemctl --user disable --now nz-scorecards-away
#   systemctl --user enable  --now nz-scorecards-nightly
Description=NZ scorecards unattended — stratified veracity resolution
After=network-online.target
# Only one scheduler may hold the subscription. The nightly unit is DISABLED
# for the duration rather than relying on this alone: both are
# WantedBy=default.target, so with both enabled the boot order decides which
# one wins and Conflicts= resolves it by killing whichever lost. This is the
# backstop for a hand-started nightly, not the mechanism.
Conflicts=nz-scorecards-nightly.service
# No restart rate-limiting. The default (5 starts per 10s) is designed for a
# service that flaps on startup; over several days of 5-minute retries it can
# only produce a false "start request repeated too quickly" and a dead run.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/act65/Documents/repos/pol-score-cards/attribute-extraction
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/act65/.local/bin:/home/act65/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/act65/miniconda3/bin/python tonight.py burst --until "2026-10-26 09:00" --stages calibration
Restart=on-failure
RestartSec=300
# Exit 1 means this invocation is malformed -- a deadline already in the past
# is the one that matters here, since `burst` refuses it and would otherwise be
# restarted into the same refusal every 5 minutes for as long as the machine is
# up. Retrying cannot fix an argument. The failures worth restarting arrive as
# EX_FAIL (70, burst ended early with work left -- see tonight.burst) or as a
# signal (OOM, SIGKILL), and both still restart.
RestartPreventExitStatus=1
StandardOutput=append:/home/act65/Documents/repos/pol-score-cards/attribute-extraction/nightly.log
StandardError=append:/home/act65/Documents/repos/pol-score-cards/attribute-extraction/nightly.log

[Install]
WantedBy=default.target

# --- 2026-10-10: switched from resolve_veracity to calibration ---------------
# Veracity verification is PAUSED at the user's instruction (657 of a cap-30
# stratified 3,924, ~$3.72/verdict). Calibration full term was chosen over
# finishing it: cheaper (~$2,458 vs ~$4,400), and it measures the thing the
# veracity cost question was really about -- unwarranted certainty rather than
# claim-by-claim truth.
#
# Sizing from pilot_calibration/README.md, measured not guessed: $0.443/call,
# 95 windows/h, 5,548 windows => ~58h, ~$2,458. The deadline above is 2026-10-16 09:00,
# which is ~5.8 days -- deliberately more than 58h, because the subscription
# cap will almost certainly interrupt this at least once and the run has to be
# able to sit out a reset and resume. Resume is by window_id read from
# --out (calibration_scores_v3.jsonl), so an interruption costs nothing.
#
# IDLE_STRIKES in overnight_run.py is what makes that safe now: the 2026-10-06
# veracity run hit the subscription limit and napped ~300 times against a
# wedged process, losing four days. Six no-progress passes now exit EX_FAIL so
# this unit replaces the process instead.

# --- 2026-10-12 08:57: PAUSED at 3,905/5,548 (70.4%) --------------------------
# Paused at the user's request to keep the rest of the week's subscription
# window for interactive use -- they were near 80% for the week. Not a fault:
# 41.2h unbroken, 95 calls/h, $1,511 of list-price usage, no subscription
# interruption at all.
#
# The deadline above was moved 16 Oct -> 26 Oct for exactly one reason: a
# deadline in the past makes `burst` exit EX_FAIL the instant it starts, and
# RestartPreventExitStatus=1 then (correctly) refuses to retry. So resuming
# after a multi-day pause needs the deadline ahead of today or nothing runs.
#
# RESUME -- one command, nothing else to set up:
#   systemctl --user enable --now nz-scorecards-away
# Resume is by window_id read from calibration_scores_v3.jsonl
# (extract_hansard._saved_ids), verified at the pause: all 3,905 completed
# windows are skipped. ~1,643 windows remain = ~17h, ~$636.
#
# The corpus is covered in date order, so the pause leaves 2025-08-14 onward
# unscored -- i.e. the LAST ~15 months of the term. Do not compute per-MP
# aggregates from the partial file: coverage is complete for every MP up to
# Aug 2025 and absent after it, which is a period bias, not a sample.
